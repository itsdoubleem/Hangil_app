<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred off the device. Progress lives in the
     WebView's own storage and the app has a backup file you export yourself. -->
<data-extraction-rules>
    <cloud-backup><exclude domain="root" /></cloud-backup>
    <device-transfer><exclude domain="root" /></device-transfer>
</data-extraction-rules>
