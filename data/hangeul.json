        {
          "ch": "ㄱ",
          "rom": "g / k",
          "say": "기역",
          "hint": "g at the start of a word, k at the end",
          "ex": {
            "ko": "공장",
            "rom": "gongjang",
            "en": "factory"
          }
        },
        {
